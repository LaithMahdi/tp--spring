      "item": [
        {
          "name": "Creer une categorie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('categoryId', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Informatique\",\n  \"description\": \"Produits informatiques\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories/create", "host": [ "{{baseUrl}}" ], "path": [ "categories", "create" ] }
          }
        },
        {
